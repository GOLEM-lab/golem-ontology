  <rdf:Description rdf:nodeID="Nddbbbd743bb54004ad96c394fef5ee3d">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://erlangen-crm.org/240307/P56i_is_found_on"/>
