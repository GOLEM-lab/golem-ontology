  <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/ont/dlp/ExtendedDnS.owl#unifies">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/ExtendedDnS.owl#unified-by"/>
    <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/ExtendedDnS.owl#description"/>
    <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/ExtendedDnS.owl#collection"/>
    <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/ExtendedDnS.owl#references"/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Based on characterizing roles, collections specifically depend on some description.We can therefore build a new relation of unification between collections and the descriptions on which they depend. Unification is axiomatized by means of sufficient conditions, and is not temporalized, since changing the description (differently from changing some members) creates a new collection.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc59105392645452e8c8c93c27b252698">
