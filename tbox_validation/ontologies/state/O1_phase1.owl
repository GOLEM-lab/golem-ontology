    <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/DOLCE-Lite.owl#arbitrary-sum"/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An endurant having a direct physical (at least spatial) quality.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne9cda93e1a794b989934907a38a0eeeb">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
