    <rdf:first rdf:nodeID="N385b67cd2a654c3cbf3359866fe2d99c"/>
    <rdf:rest rdf:nodeID="Nf62e71ab5ab74d6cbc7029e1b0d54938"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb76f5191257b4699a2ca713fd1d2a1cb">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://erlangen-crm.org/240307/P26_moved_to"/>
    <owl:someValuesFrom rdf:resource="http://erlangen-crm.org/240307/E53_Place"/>
