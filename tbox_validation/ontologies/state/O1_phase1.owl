  </rdf:Description>
  <rdf:Description rdf:nodeID="N02133c90d5a64d9bb47d114724a931c8">
    <rdf:first rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/ExtendedDnS.owl#action"/>
    <rdf:rest rdf:nodeID="Ndd825b366f154f3490da44e0fadedb6a"/>
