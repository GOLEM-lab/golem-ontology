  <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/ont/dlp/ExtendedDnS.owl#technique">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/ExtendedDnS.owl#method"/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A technique is a practical method to obtain some modification in the environment (or evaluation of an environment) that fulfils some task.
Differently from a plan, a technique does not necessarily contains a goal or objective as a proper part.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N54fe6a9e12f84616a00d4b4f1fb84c61">
