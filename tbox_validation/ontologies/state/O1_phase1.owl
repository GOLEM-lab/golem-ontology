    <owl:intersectionOf rdf:nodeID="N3048f4f195b34f0d99cb5e3d5622a636"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2ddf7e00c5ed46c888a51b6ef41ff01d">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/ExtendedDnS.owl#refined-by"/>
    <owl:allValuesFrom rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/ExtendedDnS.owl#agentive-figure"/>
