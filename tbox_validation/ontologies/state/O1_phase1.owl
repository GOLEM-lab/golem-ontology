  <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/ont/dlp/DOLCE-Lite.owl#stative">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/DOLCE-Lite.owl#perdurant"/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An occurrence-type is stative or eventive according  to whether it holds of the mereological sum of two of its instances, i.e. if it is  cumulative or not. A sitting occurrence is stative since the sum of two sittings  is still a sitting occurrence.</rdfs:comment>
  </rdf:Description>
