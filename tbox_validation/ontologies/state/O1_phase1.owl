  <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/ont/dlp/ExtendedDnS.owl#gestalt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/ExtendedDnS.owl#theory"/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A perceptual structure, from the descriptive viewpoint. In other words, this encodes the conditions by which a configuration, structure, or arrangement is perceived as a meaningful whole by a perceiving agent.</rdfs:comment>
  </rdf:Description>
