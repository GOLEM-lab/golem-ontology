    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/ExtendedDnS.owl#course"/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The course of events typical of the life of an object (kind).</rdfs:comment>
  </rdf:Description>
