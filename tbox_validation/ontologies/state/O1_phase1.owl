    <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/DOLCE-Lite.owl#mediated-relation"/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Presence of a physical quality when inheres in  an endurant.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf70a1a5be83c45188a2270e7645eee53">
