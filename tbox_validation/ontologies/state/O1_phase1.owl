    <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/DOLCE-Lite.owl#proper-part"/>
    <owl:someValuesFrom rdf:nodeID="N012f526a26b74af08213ac0b504652f2"/>
