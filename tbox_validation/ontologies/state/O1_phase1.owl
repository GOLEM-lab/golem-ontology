  <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/ont/dlp/ExtendedDnS.owl#activity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="Nf4adb8f231b04513b54d173d82e07427"/>
    <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/ExtendedDnS.owl#action"/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In dependency terms, an activity is an action that is generically constantly dependent on a (at least partly) shared plan adopted by participants. This condition implies that an action must be sequenced by a task.Intuitively, activities are complex actions that are at least partly conventionally planned.</rdfs:comment>
  </rdf:Description>
