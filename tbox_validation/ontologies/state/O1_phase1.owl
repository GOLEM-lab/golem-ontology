  <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/ont/dlp/ExtendedDnS.owl#plays">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/ExtendedDnS.owl#played-by"/>
    <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/DOLCE-Lite.owl#endurant"/>
    <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/ExtendedDnS.owl#role"/>
    <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/ExtendedDnS.owl#classified-by"/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This is the immediate relation between roles and endurants. A role classifies the position (function, use, relevance, ...) of an endurant within a context (description). Roles can be ordered, interdependent, at different layers. etc.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/ont/dlp/DOLCE-Lite.owl#temporary-atomic-part">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/DOLCE-Lite.owl#mediated-relation"/>
    <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/DOLCE-Lite.owl#proper-part"/>
    <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/DOLCE-Lite.owl#part"/>
    <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/DOLCE-Lite.owl#partly-compresent"/>
    <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/DOLCE-Lite.owl#temporary-proper-part"/>
    <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/DOLCE-Lite.owl#immediate-relation"/>
    <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/DOLCE-Lite.owl#temporary-part"/>
    <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/DOLCE-Lite.owl#mediated-relation-i"/>
    <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/DOLCE-Lite.owl#endurant"/>
    <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/DOLCE-Lite.owl#temporary-atomic-part-of"/>
    <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/DOLCE-Lite.owl#endurant"/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Having an atom as part at a time t.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N8084711df9064dda939b4d8256d14319">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
