    <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/DOLCE-Lite.owl#total-constant-participant"/>
    <owl:someValuesFrom rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/ExtendedDnS.owl#agentive-physical-object"/>
  </rdf:Description>
