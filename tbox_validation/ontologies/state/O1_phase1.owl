    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nfa66ea8e652846f8a1692b171014d84d">
    <rdf:first rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/ExtendedDnS.owl#description"/>
    <rdf:rest rdf:nodeID="N046c75d79e924eb793073fd198cec3f7"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N8decbd292aad4d5e9bbc12e932bb0550">
    <rdf:first rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/ExtendedDnS.owl#role"/>
