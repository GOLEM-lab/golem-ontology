  <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/ont/dlp/ExtendedDnS.owl#personifies">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/ExtendedDnS.owl#personified-by"/>
    <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/ExtendedDnS.owl#figure"/>
    <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/DOLCE-Lite.owl#particular"/>
    <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/ExtendedDnS.owl#references"/>
    <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A figure can personify a particular, e.g. the holy grail or a goddess, or an organization, which personifies a (postulated) collective.</rdfs:comment>
  </rdf:Description>
