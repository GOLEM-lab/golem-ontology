  <rdf:Description rdf:about="http://erlangen-crm.org/240307/P90_has_value">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <rdfs:comment>This property allows an instance of E54 Dimension to be approximated by an instance of E60 Number primitive.</rdfs:comment>
    <rdfs:label>P90 has value</rdfs:label>
    <skos:example>Kudos (E54) has value 59 (E60).
(Smile as Bright as the Sun as You Fade into Darkness from AO3)</skos:example>
    <skos:example>Word count (E54) has value 1,337 (E60).</skos:example>
  </rdf:Description>
