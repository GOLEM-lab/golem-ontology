  <rdf:Description rdf:about="https://w3id.org/golem/ontology#GP0i_is_feature_of">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/region.owl#isRegionFor"/>
    <rdfs:domain rdf:resource="https://w3id.org/golem/ontology#G2_Feature"/>
    <rdfs:range rdf:resource="http://erlangen-crm.org/240307/E28_Conceptual_Object"/>
    <rdfs:comment>Indicates that a narrative or character has certain features.</rdfs:comment>
    <rdfs:label>is feature of</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n43ae1f1b737245548d0fdb39e48725cdb66">
