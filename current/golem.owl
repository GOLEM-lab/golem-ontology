    <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/DOLCE-Lite.owl#generic-location-of"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/golem/ontology#G1_Character"/>
