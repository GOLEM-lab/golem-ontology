  </rdf:Description>
  <rdf:Description rdf:about="http://www.ontologydesignpatterns.org/ont/dlp/DOLCE-Lite.owl#generic-location-of">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">generic location of</rdfs:label>
    <skos:example>Quidditch World Cup Campsite (G13) is generic location of Harry Potter (G1).</skos:example>
    <skos:example>Quidditch World Cup Campsite (G13) is generic location of Quidditch banners and flags (G16).</skos:example>
  </rdf:Description>
