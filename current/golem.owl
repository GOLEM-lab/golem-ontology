    <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dlp/ExtendedDnS.owl#played-by"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/golem/ontology#G1_Character"/>
  </rdf:Description>
