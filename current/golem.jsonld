  "@graph": [
    {
      "@id": "dlp_funct:has-state",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Participation in a state  ([DOLCE-Lite-Plus, 2005](https://www.w3.org/2001/sw/BestPractices/WNET/DLP3941_daml.html))."
        },
        "In GOLEM, indicates the psychological state (G3) of a character (G1)."
      ],
      "rdfs:label": {
        "@language": "en",
        "@value": "has-state"
      },
      "skos:example": "Ron in Harry Potter and the Goblet of Fire (G1) has state “jealousy” (G3) during the event Yule Ball (G5)."
    },
    {
      "@id": "skos:notation",
      "@type": "owl:AnnotationProperty"
    },
    {
      "@id": "xsd:date",
      "@type": "rdfs:Datatype"
    },
    {
      "@id": "dol:participant-in",
      "@type": "owl:ObjectProperty",
      "rdfs:label": {
        "@language": "en",
        "@value": "participant in"
      },
      "skos:example": [
        "Harry Potter (G1) participant in the Battle of Hogwarts (G5).",
        "The egg (G16) participant in the event in which Cedric gives Harry a hint (G5) (chapter 24 of Harry Potter and the Goblet of Fire)."
      ]
    },
    {
      "@id": "lrmoo:R3_is_realised_in",
      "@type": "owl:ObjectProperty",
      "owl:inverseOf": {
        "@id": "lrmoo:R3i_realises"
      },
      "rdfs:comment": [
        {
          "@language": "en",
          "@value": "Quantification: one to many, necessary, dependent (1,n:1,1)\n\nScope note: \n\nThis property associates an instance of F2 Expression with an instance of F1 Work. This property expresses the association that exists between an expression and the work that this expression conveys. Our factual knowledge of how a given work is historically realised into expressions is often limited. Therefore, this property makes it possible to express the association between an instance of F2 Expression and the instance of F1 Work it conveys without identifying the particular instances of F2 Expression that were part of a chain of derivation from the source."
        },
        "In GOLEM, a narrative or idea (work) is realized in a specific expression, such as a text, movie, performance, or other medium."
      ],
      "rdfs:domain": {
        "@id": "lrmoo:F1_Work"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "R3 is realised in"
      },
      "rdfs:range": {
        "@id": "lrmoo:F2_Expression"
      },
      "rdfs:subPropertyOf": {
        "@id": "ecrm:P130_shows_features_of"
      },
      "skos:example": "The work Harry Potter and the Deathly Hallows (F1) is realised in the text of Harry Potter and the Deathly Hallows (Rowling, 2007) (F2)."
    },
    {
      "@id": "dlp_extDnS:sequenced-by",
      "@type": "owl:ObjectProperty",
      "rdfs:label": {
        "@language": "en",
        "@value": "sequenced-by"
      }
    },
    {
      "@id": "dcterms:source",
      "@type": "owl:AnnotationProperty"
    },
