    {
      "@id": "golem:G4_Social_Relationship",
      "@type": "owl:Class",
      "owl:disjointWith": {
        "@id": "golem:G13_Narrative_Location"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "“A social description defining roles for the interaction of cognitive agents (DOLCE-Lite-Plus, 2005)” or dlp:agentive-social-objects. Characters are involved in social relationships."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "G4 Social Relationships"
      },
