        },
        {
          "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b75"
        },
        {
          "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b76"
        },
        {
          "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b77"
        },
        {
          "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b78"
        },
        {
          "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b79"
        },
        {
          "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b80"
        },
        {
          "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b81"
        }
      ],
      "skos:example": "\"There was a clatter as the basilisk fangs cascaded out of Hermione’s arms [process event]. Running at Ron [process event], she flung them around his neck and kissed him full on the mouth [change of state]. Ron threw away the fangs and broomstick [process event] he was holding and responded with such enthusiasm that he lifted Hermione off her feet [change of state].\""
    },
