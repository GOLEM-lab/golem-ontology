        "@value": "proper part"
      },
      "skos:example": [
        "Harry Potter and the Deathly Hallows (Rowling, 2007) (F1) has proper part Hyleme “Harry’s triumph, as Voldemort dies from his rebounded curse” (G9).",
        "Hogwarts School of Witchcraft and Wizardry (G13) has proper part Forbidden Forest (G13)."
      ]
    },
    {
      "@id": "dlp_extDnS:d-uses",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "This property links a (dlp:)description, such as a work (F1) or relationship (G4), to a (dlp:)role, like a narrative function (G10) or a relationship role (G6). It also  links a work (F1) to a (dlp:)course, like fabula or syuzhet (G7_Narrative_Sequence)."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "d-uses"
      },
      "skos:example": [
        "Harry Potter and the Deathly Hallows (Rowling, 2007) (F1) d-uses the fabula of Harry Potter and the Deathly Hallows (G7).",
        "Romantic love between Ron and Hermione (G4) d-uses the role \"lover\" (G6)."
      ]
    },
