      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "“Character is a text- or media-based figure in a storyworld, usually human or human-like,” understood through readers’ knowledge of real people (Jannidis, 2019). Readers attribute to characters mental states such as intentions and beliefs, and consider them to engage in actions. Characters can have specific functional roles within narratives, such as protagonist or antagonist, influencing how readers perceive and interpret the story."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "G1 Character"
      },
      "rdfs:subClassOf": [
