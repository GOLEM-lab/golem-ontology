    {
      "@id": "golem:G2_Feature",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A feature in the context of narrative refers to a distinct element or characteristic that contributes to the structure and meaning of a story. Features include character traits and textual elements.\nTaxonomies of features can be further specified using ecrm:E55_Type."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "G2 Feature"
      },
      "rdfs:subClassOf": {
        "@id": "dul_region:Region"
      },
      "skos:example": "Style, theme, literary devices"
    },
    {
      "@id": "ecrm:P2_has_type",
      "@type": "owl:ObjectProperty",
      "skos:example": "Narrative function “Victory” (G10) has type “Proppian function” (E55)"
    },
