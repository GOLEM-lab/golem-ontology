      "@id": "golem:G15_Fandom",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A fandom is a group of fans who share a common interest in a particular work or topic, such as a book or movie, and engage in fan activities like discussions or creating fan works."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "G15 Fandom"
      },
