    {
      "@id": "golem:G12_Setting",
      "@type": "owl:Class",
      "owl:disjointWith": {
        "@id": "golem:G13_Narrative_Location"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Setting is the narrative universe in which a story unfolds, encompassing the spatial, cultural, and social contexts that shape characters and events. It defines the situation and surroundings relevant to the narrative. Defining a setting for a Work is useful for its comparative and historical analysis with respect to other works. It is particularly apt to specify differences between canonical and fanfiction works that have Alternate Universe settings."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "G12 Setting"
      },
      "rdfs:subClassOf": [
        {
          "@id": "dlp_extDnS:situation"
        },
        {
          "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b27"
        },
        {
          "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b28"
        },
        {
          "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b29"
        },
        {
          "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b30"
        },
        {
          "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b31"
        },
        {
          "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b32"
        }
      ],
      "skos:example": "The Wizarding World for the Harry Potter novels. \nThe “setting of “Eveline” [by J. Joyce] is early 20th-century lower-middle-class Dublin\" (Ryan, 2015)."
    },
    {
      "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b27",
