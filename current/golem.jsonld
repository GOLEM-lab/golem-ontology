      "@id": "dol:participant",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "In GOLEM, indicates that an endurant, such as a character (G1) or object (G16), participates in a specific narrative event (G5)."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "participant"
      }
    },
