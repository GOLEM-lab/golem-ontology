        },
        {
          "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b7"
        },
        {
          "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b8"
        }
      ],
      "skos:example": "*Harry Potter and the Philosopher's Stone* (movie, 2001)."
    },
    {
      "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b4",
