    {
      "@id": "dlp_extDnS:modal-target",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": "In GOLEM, it relates a narrative function (G10) or narrative role (G11) to their target sequence of narrative events (dlp:perdurants), like fabula or syuzhet (G7_Narrative_Sequence). This property is useful both to link tropes to the whole course of action of a story and to retrieve all the narrative functions associated with the events of a story. It can also be used to specify the relationship roles (G6) of a social relationship (G4).",
      "rdfs:label": {
        "@language": "en",
        "@value": "modal target"
      }
    },
