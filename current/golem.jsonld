        "@id": "rdf:"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Seq"
      }
    },
    {
      "@id": "dlp_spat:participant-place-of",
      "@type": "owl:ObjectProperty",
      "rdfs:label": {
        "@language": "en",
        "@value": "participant place of"
      }
    },
    {
      "@id": "skos:prefLabel",
      "@type": "owl:AnnotationProperty"
