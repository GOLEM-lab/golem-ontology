      "dc:title": "GOLEM Ontology",
      "dcterms:bibliographicCitation": "Pianzola, F., Pannach, F., Cheng, L., Yang, X, and Scotti, L. (2024). GOLEM Ontology for Narrative and Fiction. https://doi.org/10.5281/zenodo.14911392",
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2024-10-10"
      },
      "dcterms:creator": "GOLEM Lab",
      "dcterms:hasVersion": "2.0.0",
