    {
      "@id": "dlp_extDnS:satisfies",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": "In GOLEM, this property links  a setting (G12) to  a work (F1).",
      "rdfs:label": {
        "@language": "en",
        "@value": "satisfies"
      },
      "skos:example": "The setting of \"Wizarding community rivalries during the Triwizard Tournament\" (G12) satisfies the work Harry Potter and the Goblet of Fire (F1)."
    },
    {
      "@id": "dc:creator",
      "@type": "owl:AnnotationProperty"
    },
    {
      "@id": "rdfs:label",
      "@type": "owl:AnnotationProperty",
      "rdfs:comment": "A human-readable name for the subject.",
      "rdfs:isDefinedBy": {
        "@id": "rdfs:"
      },
      "rdfs:label": "label"
    },
    {
      "@id": "dlp_extDnS:flux",
      "rdfs:comment": "Fluxes are processes that (also) contain accomplishments as constituents. In other words, fluxes emerge out of accomplishments."
    },
    {
      "@id": "dlp_extDnS:sequences",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": "In GOLEM, indicates that a fabula or syuzhet (G7) sequences narrative events in a specific order.",
      "rdfs:label": {
        "@language": "en",
        "@value": "sequences"
      },
      "skos:example": "The fabula and syuzhet (G7) of Battle of Hogwarts in Harry Potter and the Deathly Hallows (J. K. Rowling, 2007) sequences a series of individual events"
    },
    {
      "@id": "golem:G13_Narrative_Location",
      "@type": "owl:Class",
      "owl:disjointWith": {
        "@id": "dlp_csm:non-physical-place"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "A narrative location is the spatial context in which events unfold—serving as the immediate frame of action within a story. It is a non-agentive social object shaped by the narrative structure. While it may derive features from real-world locations, it exists solely as an entity within the narrative domain."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "G13 Narrative Location"
      },
      "rdfs:subClassOf": [
        {
          "@id": "dlp_extDnS:non-agentive-social-object"
        },
        {
          "@id": "ecrm:E28_Conceptual_Object"
        },
        {
          "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b33"
        },
        {
          "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b34"
        },
        {
          "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b35"
        },
        {
          "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b36"
        },
        {
          "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b37"
        },
        {
          "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b38"
        }
      ],
      "skos:example": "'England' or the 'Forbidden Forest' as depicted in the Harry Potter series—both conceived and situated within the fictional narrative context.\" ."
    },
    {
      "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b33",
