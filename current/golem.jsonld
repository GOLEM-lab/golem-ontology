    },
    {
      "@id": "ecrm:E89_Propositional_Object",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b17"
      }
    },
    {
