      "@type": "owl:AnnotationProperty"
    },
    {
      "@id": "ecrm:P90_has_value",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": "This property allows an instance of E54 Dimension to be approximated by an instance of E60 Number primitive.",
      "rdfs:label": "P90 has value",
      "rdfs:range": {
        "@id": "rdfs:Literal"
      },
      "skos:example": [
