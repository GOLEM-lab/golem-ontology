    {
      "@id": "golem:G14_Narrative-Stoff",
      "@type": "owl:Class",
      "owl:disjointWith": {
        "@id": "golem:G15_Fandom"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Narrative Stoff refers to the fundamental materials that form the basis of a narrative. It contains a chronological sequence of events (golem:G7_Narrative_Sequence) that could be manifested across various narratives and media. This concept highlights the potential variations of narrative units within different contexts."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "G14 Narrative-Stoff"
      },
      "rdfs:subClassOf": [
        {
          "@id": "ecrm:E28_Conceptual_Object"
        },
        {
          "@id": "dlp_extDnS:description"
        },
        {
          "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b39"
        }
      ],
      "skos:example": "Apollo and Zephyros love Hyacinthus. While Apollo and Hyacinthus are playing a game with a discus, Zephyros uses the wind to change its direction, causing the discus to hit Hyacinthus and resulting in his death. Afterward, Hyacinthus transforms into a flower."
    },
    {
      "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b39",
      "@type": "owl:Restriction",
      "owl:onProperty": {
        "@id": "ecrm:P130i_features_are_also_found_on"
      },
      "owl:someValuesFrom": {
        "@id": "golem:G7_Narrative_Sequence"
      }
    },
