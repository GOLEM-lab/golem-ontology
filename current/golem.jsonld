      }
    },
    {
      "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b6",
      "@type": "owl:Restriction",
      "owl:onProperty": {
        "@id": "dol:proper-part"
      },
      "owl:someValuesFrom": {
        "@id": "golem:G9_Narrative_Unit"
      }
    },
    {
      "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b7",
      "@type": "owl:Restriction",
      "owl:onProperty": {
        "@id": "dlp_extDnS:d-uses"
      },
      "owl:someValuesFrom": {
        "@id": "golem:G7_Narrative_Sequence"
      }
    },
    {
      "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b8",
      "@type": "owl:Restriction",
      "owl:onProperty": {
