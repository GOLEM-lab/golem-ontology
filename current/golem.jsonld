      "@type": "owl:ObjectProperty",
      "rdfs:comment": "In GOLEM, indicates that a general event (G5) contains one or more sub-events (G5) or psychological states (G3).",
      "rdfs:label": {
        "@language": "en",
        "@value": "temporally includes"
      },
      "skos:example": [
        "The Battle of Hogwarts (G5) temporally includes the death of Voldemort (G5).",
