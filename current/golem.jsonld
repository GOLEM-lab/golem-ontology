    {
      "@id": "golem:G10_Narrative_Function",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A narrative function refers to the functional roles that narrative units play within a story. For instance, the Proppian function (Propp, 1968) \"Villain causes harm or injury\" can be illustrated by the narrative unit where Zephyros causes Hyacinthus's death."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "G10 Narrative Function"
      },
      "rdfs:subClassOf": [
        {
          "@id": "dlp_extDnS:role"
        },
        {
          "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b21"
        },
        {
          "@id": "_:n3550b387edeb40d59b2f372a3e7c0289b22"
